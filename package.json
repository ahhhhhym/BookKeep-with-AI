{
  "name": "bookkeepai",
  "version": "0.1.3",
  "private": true,
  "description": "BookKeepAI 中文桌面 AI 辅助记账",
  "author": "BookKeepAI",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dataset:demo": "node scripts/dataset-demo.mjs",
    "verify:icons": "node scripts/verify-icons.mjs",
    "db:report": "node scripts/db-report.mjs",
    "licenses": "node scripts/collect-licenses.mjs",
    "smoke:electron": "node scripts/smoke-electron.mjs",
    "icon:generate": "node scripts/make-icon.mjs",
    "verify": "npm run typecheck && npm run test && npm run verify:icons && npm run build && npm run smoke:electron",
    "package:zip": "node scripts/package-zip.mjs",
    "package:release": "node scripts/release-desktop.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "verify:zip": "node scripts/verify-zip.mjs",
    "clean": "node scripts/clean.mjs",
    "test:regression": "node scripts/regression.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "lucide-react": "1.60.0",
    "lucide-static": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "electron@44.9.1": true,
    "esbuild@0.28.2": true
  }
}
