# 依赖与构建产物（DSH 编写；不提交开发依赖或打包结果）
/node_modules/
/dist/
/release/
/out/
/coverage/
/.vite/
/.tmp/
*.tsbuildinfo

# 本地环境与凭证（任何情况下不得提交）
.env
.env.*
!.env.example
*.pem
*.key
*.pfx

# 运行期数据（真实账本/附件/日志绝不进仓库）
/data/
*.db
*.db-wal
*.db-shm

# 编辑器与系统临时文件
.vscode/
.idea/
Thumbs.db
Desktop.ini
*.log
# 证据日志需要入库（S04 起的命令输出留证）
!evidence/**/logs/*.log
npm-debug.log*
